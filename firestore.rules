    }

    function isTripOwner(tripId) {
      return isAuthed() &&
        request.auth.uid == get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
    }

    function isValidTrip() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'destination', 'startDate', 'endDate',
                              'inviteCode', 'ownerId', 'memberIds', 'createdAt'])
          && d.name is string       && d.name.size() > 0 && d.name.size() <= 100
          && d.destination is string && d.destination.size() > 0
          && d.inviteCode is string  && d.inviteCode.size() == 6
          && d.ownerId == request.auth.uid
          && d.memberIds is list
          && d.memberIds.size() == 1
          && d.memberIds[0] == request.auth.uid;
    }

    // ✅ NEW: Timeline validation
    function isValidTimelineEvent(tripId) {
      let d = request.resource.data;
      return d.keys().hasAll([
        'tripId', 'title', 'date', 'startTime',
        'durationMinutes', 'color', 'sourceType', 'createdBy', 'tags'
      ])
      && d.tripId == tripId
      && d.title is string && d.title.size() > 0 && d.title.size() <= 200
      && d.date is string && d.date.size() == 10
      && d.startTime is string && d.startTime.size() == 5
      && d.durationMinutes is number && d.durationMinutes >= 15
      && d.sourceType in ['bucket', 'custom']
      && d.createdBy == request.auth.uid
      && d.tags is list;
    }

    // (keeping all your deployed validation functions untouched...)

    function isValidBucketItem() {
      let d = request.resource.data;
      return d.keys().hasAll([
        'placeId', 'name', 'address', 'photoUrl', 'rating',
        'addedById', 'addedByName', 'addedByPhotoUrl',
        'createdAt', 'order', 'upvotes', 'downvotes', 'score', 'votesByUser'
      ])
      && d.placeId is string && d.placeId.size() > 0
      && d.name is string && d.name.size() > 0
      && d.address is string
      && d.photoUrl is string
      && d.rating is number
      && d.addedById == request.auth.uid
      && d.createdAt is timestamp
      && d.order is number
      && d.upvotes == 0
      && d.downvotes == 0
      && d.score == 0
      && d.votesByUser is map;
    }

<<<<<<< HEAD
    function isValidBucketLocation(d) {
      return !d.keys().hasAny(['location'])
        || (d.location is map
          && d.location.keys().hasAll(['lat', 'lng'])
          && d.location.lat is number
          && d.location.lng is number);
    }

    function isValidBucketUserData(d) {
      return !d.keys().hasAny(['userData'])
        || (d.userData is map
          && (!d.userData.keys().hasAny(['customTitle']) || d.userData.customTitle is string)
          && (!d.userData.keys().hasAny(['notes']) || d.userData.notes is string)
          && (!d.userData.keys().hasAny(['proposedTime']) || d.userData.proposedTime is string)
          && (!d.userData.keys().hasAny(['activityType']) || d.userData.activityType is string)
          && (!d.userData.keys().hasAny(['priority']) || d.userData.priority is string)
          && (!d.userData.keys().hasAny(['tags']) || d.userData.tags is list)
          && (!d.userData.keys().hasAny(['durationMinutes']) || d.userData.durationMinutes is number));
    }

    function isValidBucketWeather(d) {
      return !d.keys().hasAny(['weather'])
        || (d.weather is map
          && d.weather.keys().hasAll([
            'temperature', 'condition', 'conditionCode',
            'sunrise', 'sunset', 'isGoldenHour', 'isContingency', 'updatedAt'
          ])
          && d.weather.temperature is number
          && d.weather.condition is string
          && d.weather.conditionCode is number
          && d.weather.sunrise is number
          && d.weather.sunset is number
          && d.weather.isGoldenHour is bool
          && d.weather.isContingency is bool
          && d.weather.updatedAt is number);
    }

    function isValidVoteUpdate() {
      let d = request.resource.data;
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['upvotes', 'downvotes', 'score', 'votesByUser'])
        && d.upvotes is number
        && d.downvotes is number
        && d.score == d.upvotes - d.downvotes;
    }

    function isValidOrderUpdate() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['order'])
        && request.resource.data.order is number;
    }

    function isValidWeatherUpdate() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['weather'])
        && isValidBucketWeather(request.resource.data);
    }

    function isValidExpenseSplit(split) {
      return split is map
        && split.keys().hasAll(['userId', 'amount'])
        && split.userId is string
        && split.amount is number
        && split.amount >= 0
        && (!split.keys().hasAny(['percentage']) || split.percentage is number);
    }

    function isValidExpenseSplitType(splitType) {
      return splitType in ['equal', 'percentage', 'fixed'];
    }

    function isValidExpenseCreate(tripId) {
      let d = request.resource.data;
      return d.keys().hasAll([
        'tripId', 'paidBy', 'amount', 'category', 'subcategory', 'description',
        'date', 'splitType', 'splits', 'settled', 'createdAt', 'updatedAt'
      ])
      && d.tripId == tripId
      && d.paidBy == request.auth.uid
      && d.amount is number
      && d.amount > 0
      && d.category is string
      && d.subcategory is string
      && d.description is string
      && d.date is number
      && d.splitType is string
      && isValidExpenseSplitType(d.splitType)
      && d.splits is list
      && d.splits.size() > 0
      && d.settled is bool
      && d.createdAt is number
      && d.updatedAt is number;
    }

    function isValidExpenseUpdate() {
      let d = request.resource.data;
      return d.keys().hasAll([
        'tripId', 'paidBy', 'amount', 'category', 'subcategory', 'description',
        'date', 'splitType', 'splits', 'settled', 'createdAt', 'updatedAt'
      ])
      && d.tripId == resource.data.tripId
      && d.paidBy == resource.data.paidBy
      && d.amount is number
      && d.amount > 0
      && d.category is string
      && d.subcategory is string
      && d.description is string
      && d.date is number
      && d.splitType is string
      && isValidExpenseSplitType(d.splitType)
      && d.splits is list
      && d.splits.size() > 0
      && d.splits[0] is map
      && isValidExpenseSplit(d.splits[0])
      && (d.splits.size() < 2 || isValidExpenseSplit(d.splits[1]))
      && (d.splits.size() < 3 || isValidExpenseSplit(d.splits[2]))
      && (d.splits.size() < 4 || isValidExpenseSplit(d.splits[3]))
      && (d.splits.size() < 5 || isValidExpenseSplit(d.splits[4]))
      && (d.splits.size() < 6 || isValidExpenseSplit(d.splits[5]))
      && (d.splits.size() < 7 || isValidExpenseSplit(d.splits[6]))
      && (d.splits.size() < 8 || isValidExpenseSplit(d.splits[7]))
      && (d.splits.size() < 9 || isValidExpenseSplit(d.splits[8]))
      && (d.splits.size() < 10 || isValidExpenseSplit(d.splits[9]))
      && d.settled is bool
      && d.createdAt is number
      && d.updatedAt is number;
    }

    function isValidUserDataUpdate(tripId) {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['userData'])
        && (isTripOwner(tripId) || request.auth.uid == resource.data.addedById)
        && isValidBucketUserData(request.resource.data);
    }

    // ─── /users/{uid} ─────────────────────────────────────────────────────────
    // Users can only read/write their own profile document.
=======
    // ─── USERS ───────────────────────────────────────────────────────────────
>>>>>>> origin/feature/google-maps-integration

    match /users/{uid} {
      allow read:   if isUser(uid);
      allow create: if isUser(uid);
      allow update: if isUser(uid) && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // ─── TRIPS ───────────────────────────────────────────────────────────────

    match /trips/{tripId} {

      allow read: if isAuthed();
      allow create: if isAuthed() && isValidTrip();

      allow update: if (
        (
          isAuthed()
          && request.auth.uid == resource.data.ownerId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.inviteCode == resource.data.inviteCode
        )
        ||
        (
          isAuthed()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds'])
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
        )
      );

      allow delete: if false;

      // ─── MEMBERS ──────────────────────────────────────────────────────────

      match /members/{userId} {
        allow read: if isTripMember(tripId);

        allow create: if isAuthed()
          && request.auth.uid == userId
          && request.resource.data.userId == userId;

        allow update: if isTripOwner(tripId);
        allow delete: if isTripOwner(tripId) || isUser(userId);
      }

      // ─── ✅ NEW: TIMELINE ─────────────────────────────────────────────────

      match /timeline/{eventId} {
        allow read:   if isTripMember(tripId) || isTripOwner(tripId);

        // only owner can modify timeline
        allow create: if isTripOwner(tripId) && isValidTimelineEvent(tripId);
        allow update: if isTripOwner(tripId);
        allow delete: if isTripOwner(tripId);
      }

      // ─── BUCKET LIST ──────────────────────────────────────────────────────

      match /bucketList/{itemId} {
        allow read: if isTripMember(tripId);

        // keep strong validation (DO NOT downgrade)
        allow create: if isTripMember(tripId) && isValidBucketItem();

        allow update: if isTripMember(tripId);
        allow delete: if isTripOwner(tripId) || request.auth.uid == resource.data.addedById;
      }

      // ─── EXPENSES ─────────────────────────────────────────────────────────

      match /expenses/{expenseId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId);
        allow update: if isTripOwner(tripId) || request.auth.uid == resource.data.paidBy;
        allow delete: if isTripOwner(tripId) || request.auth.uid == resource.data.paidBy;
      }

      // ─── /trips/{tripId}/expenses/{expenseId} ─────────────────────────────

      match /expenses/{expenseId} {
        allow read: if isTripMember(tripId);

        allow create: if isTripMember(tripId)
                      && isValidExpenseCreate(tripId);

        allow update: if (isTripOwner(tripId) || request.auth.uid == resource.data.paidBy)
                      && isValidExpenseUpdate();

        allow delete: if isTripOwner(tripId) || request.auth.uid == resource.data.paidBy;
      }

      // ─── /trips/{tripId}/settlements/{settlementId} ───────────────────────

      match /settlements/{settlementId} {
        allow read: if isTripMember(tripId);
        allow create, update, delete: if isTripOwner(tripId);
      }
    }

    // ─── INVITES ─────────────────────────────────────────────────────────────

    match /tripInvites/{code} {
      allow get: if isAuthed();
      allow list: if false;
      allow create: if isAuthed();
      allow update: if false;
      allow delete: if false;
    }
  }
}