rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isTripMember(tripId) {
